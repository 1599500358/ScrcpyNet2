<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Device registry storage (devices.db in %AppData%\ScrcpyNet). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- ReactiveUI 25 split into a System.Reactive based stack ("*.Reactive") and a lean stack.
         These ViewModels use Rx (Unit, IObservable) so they reference the Reactive flavor. -->
    <PackageReference Include="ReactiveUI.Reactive" Version="25.1.1" />
    <PackageReference Include="DynamicData" Version="9.4.33" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScrcpyNet\ScrcpyNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy list, kept ONLY as the one-time migration seed: on the first run
         DeviceDatabase imports it into devices.db and never reads it again. -->
    <None Update="Devices.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ReactiveUI 25 split into a System.Reactive based stack ("*.Reactive") and a lean stack.
         These ViewModels use Rx (Unit, IObservable) so they reference the Reactive flavor. -->
    <PackageReference Include="ReactiveUI.Reactive" Version="25.1.1" />
    <PackageReference Include="DynamicData" Version="9.4.33" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScrcpyNet\ScrcpyNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Devices.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../build/Package.props" />

    <PropertyGroup>
        <PackageId>ScrcpyNet</PackageId>
        <Version>0.0.3</Version>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- The FFmpeg.AutoGen bindings must match the native FFmpeg dlls shipped in deps/win64
             (FFmpeg 9.0 = avcodec-63 & co). -->
        <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
        <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="9.0.1.1" />
        <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="SharpAdbClient" Version="2.3.23" />
        <!-- Override the vulnerable System.Drawing.Common 4.5.0 pulled in transitively by SharpAdbClient. -->
        <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../deps/shared/*.*" Visible="False">
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/ScrcpyNet</PackagePath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <LinkBase>ScrcpyNet</LinkBase>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>

        <Content Include="../../deps/win64/*.*" Condition="$([MSBuild]::IsOSPlatform('Windows'))" Visible="False">
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/ScrcpyNet</PackagePath>
            <LinkBase>ScrcpyNet</LinkBase>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

</Project>

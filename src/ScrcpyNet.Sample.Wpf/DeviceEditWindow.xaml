<Window x:Class="ScrcpyNet.Sample.Wpf.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{StaticResource Brush.WindowBg}"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Window.Resources>
        <!-- Labeled field text -->
        <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Input box matching the flat card look -->
        <Style x:Key="TextBox.Field" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource Brush.CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Text buttons for the dialog footer (the global Button style is icon-only) -->
        <Style x:Key="Button.Dialog" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Brush.CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (confirm) variant -->
        <Style x:Key="Button.DialogPrimary" TargetType="Button" BasedOn="{StaticResource Button.Dialog}">
            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20">
        <TextBlock x:Name="TitleText" Text="添加设备" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,16"/>

        <StackPanel x:Name="SerialSection">
            <TextBlock Text="序列号" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox x:Name="SerialBox" Style="{StaticResource TextBox.Field}"
                     ToolTip="adb 设备序列号（adb devices 可查看）"/>
        </StackPanel>

        <TextBlock Text="设备名" Style="{StaticResource Text.FieldLabel}" Margin="0,14,0,6"/>
        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" Style="{StaticResource Button.Dialog}" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="确定" Style="{StaticResource Button.DialogPrimary}" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="ScrcpyNet.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:s="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyNet.Sample.Wpf"
        xmlns:vm="clr-namespace:ScrcpyNet.Sample.ViewModels;assembly=ScrcpyNet.Sample.ViewModels"
        mc:Ignorable="d"
        Title="ScrcpyNet 设备管理" Height="600" Width="1000"
        MinHeight="400" MinWidth="640"
        Background="{StaticResource Brush.WindowBg}"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <s:Boolean x:Key="True">True</s:Boolean>
        <local:IntegerValueConverter x:Key="IntegerValueConverter"/>
        <local:VisibilityValueConverter x:Key="VisibilityConverter"/>

        <!-- Text button for the settings bar (the global Button style is icon-only). -->
        <Style x:Key="Button.BarAction" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============  App header  ============ -->
        <StackPanel Grid.Row="0" Margin="20,18,20,4">
            <TextBlock Text="ScrcpyNet" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="设备投屏管理" FontSize="12" Margin="0,2,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>

        <!-- ============  Global settings bar (persisted across restarts)  ============ -->
        <Border Grid.Row="1" Margin="20,8,20,6"
                Background="{StaticResource Brush.CardBg}"
                BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="#111827" BlurRadius="12" ShadowDepth="0" Opacity="0.05" RenderingBias="Quality"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="14,0">

                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="显示设置" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           VerticalAlignment="Center" Margin="8,0,20,0"/>

                <!-- Cards per row -->
                <TextBlock Text="每行卡片" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding Settings.CardsPerRow}" Margin="8,0,0,0" MinWidth="56">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type s:Int32}">
                            <s:Int32>2</s:Int32>
                            <s:Int32>3</s:Int32>
                            <s:Int32>4</s:Int32>
                            <s:Int32>5</s:Int32>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Device orientation -->
                <TextBlock Text="设备方向" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <ComboBox SelectedValue="{Binding Settings.Orientation}"
                          SelectedValuePath="Tag" Margin="8,0,0,0" MinWidth="72">
                    <ComboBoxItem Tag="{x:Static vm:DeviceOrientationOption.Portrait}" Content="竖屏"/>
                    <ComboBoxItem Tag="{x:Static vm:DeviceOrientationOption.Landscape}" Content="横屏"/>
                </ComboBox>

                <!-- Device management (SQLite-backed device registry) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="设备管理" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <Button Content="&#xE710; 添加设备" Style="{StaticResource Button.BarAction}"
                            Command="{Binding AddDeviceCommand}" ToolTip="将设备序列号和名称注册到数据库"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============  Device cards  ============
             Cards can be reordered manually: drag by the card header (see
             ScrcpyItem.DragHandle) and drop on any card — before its top half,
             after its bottom half. The order persists to devices.db. -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Scrcpys}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="Cards_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Cards_PreviewMouseMove"
                 DragOver="Cards_DragOver"
                 Drop="Cards_Drop"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ScrcpyItem/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Settings.CardsPerRow}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>

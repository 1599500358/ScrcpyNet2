<Window x:Class="ScrcpyNet.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:s="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyNet.Sample.Wpf"
        xmlns:vm="clr-namespace:ScrcpyNet.Sample.ViewModels;assembly=ScrcpyNet.Sample.ViewModels"
        mc:Ignorable="d"
        Title="ScrcpyNet 设备管理" Height="600" Width="1000"
        MinHeight="400" MinWidth="640"
        Background="{StaticResource Brush.WindowBg}"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <s:Boolean x:Key="True">True</s:Boolean>
        <local:IntegerValueConverter x:Key="IntegerValueConverter"/>
        <local:VisibilityValueConverter x:Key="VisibilityValueConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============  App header  ============ -->
        <StackPanel Grid.Row="0" Margin="20,18,20,4">
            <TextBlock Text="ScrcpyNet" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="设备投屏管理" FontSize="12" Margin="0,2,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>

        <!-- ============  Global settings bar (persisted across restarts)  ============ -->
        <Border Grid.Row="1" Margin="20,8,20,6"
                Background="{StaticResource Brush.CardBg}"
                BorderBrush="{StaticResource Brush.CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect Color="#111827" BlurRadius="12" ShadowDepth="0" Opacity="0.05" RenderingBias="Quality"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="14,0">

                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="显示设置" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           VerticalAlignment="Center" Margin="8,0,20,0"/>

                <!-- Cards per row -->
                <TextBlock Text="每行卡片" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding Settings.CardsPerRow}" Margin="8,0,0,0" MinWidth="56">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type s:Int32}">
                            <s:Int32>2</s:Int32>
                            <s:Int32>3</s:Int32>
                            <s:Int32>4</s:Int32>
                            <s:Int32>5</s:Int32>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Device orientation -->
                <TextBlock Text="设备方向" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <ComboBox SelectedValue="{Binding Settings.Orientation}"
                          SelectedValuePath="Tag" Margin="8,0,0,0" MinWidth="72">
                    <ComboBoxItem Tag="{x:Static vm:DeviceOrientationOption.Portrait}" Content="竖屏"/>
                    <ComboBoxItem Tag="{x:Static vm:DeviceOrientationOption.Landscape}" Content="横屏"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ============  Device cards  ============ -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Scrcpys}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:ScrcpyItem/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Settings.CardsPerRow}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>

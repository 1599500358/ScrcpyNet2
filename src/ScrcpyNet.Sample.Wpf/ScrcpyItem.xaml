<rxui:ReactiveUserControl x:TypeArguments="vm:ScrcpyViewModel"  x:Class="ScrcpyNet.Sample.Wpf.ScrcpyItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:rxui="http://reactiveui.net"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScrcpyNet.Sample.ViewModels;assembly=ScrcpyNet.Sample.ViewModels"
        xmlns:scrcpy="clr-namespace:ScrcpyNet;assembly=ScrcpyNet"
        xmlns:scrcpyWpf="clr-namespace:ScrcpyNet.Wpf;assembly=ScrcpyNet.Wpf"
        mc:Ignorable="d">

    <!-- =====================  Device card  =====================
         The video area (not the whole card) keeps the REAL screen ratio of the
         device it mirrors (from the stream size, see ScrcpyDisplay.DisplayedAspectRatio);
         unconnected cards fall back to the default ratio from AppSettings. Header
         and toolbar add their fixed height on top. VerticalAlignment=Top sizes the
         card to its content: the UniformGrid cell otherwise stretches a lone card
         over the full ListBox height. -->
    <Border VerticalAlignment="Top"
            Background="{StaticResource Brush.CardBg}"
            BorderBrush="{StaticResource Brush.CardBorder}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#111827" BlurRadius="20" ShadowDepth="0" Opacity="0.08" RenderingBias="Quality"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- ============  Header: status dot + device name + status  ============ -->
            <Grid Grid.Row="0" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Style="{StaticResource Shape.StatusDot}" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding DeviceName, FallbackValue=等待设备…}"
                           Style="{StaticResource Text.CardTitle}"/>

                <TextBlock Grid.Column="2" Style="{StaticResource Text.Status}"/>
            </Grid>

            <!-- Thin divider under the header -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                    Background="{StaticResource Brush.CardBorder}"
                    Margin="16,0"/>

            <!-- ============  Video area (dark, rounded corners, device's real ratio)  ============ -->
            <Border x:Name="VideoMask" Grid.Row="1"
                    Background="{StaticResource Brush.VideoBg}"
                    Margin="14,2" CornerRadius="10">
                <Border.Height>
                    <MultiBinding Converter="{StaticResource AspectRatioHeightConverter}">
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                        <!-- Real ratio of this device's stream; 0 while unconnected. -->
                        <Binding Path="DisplayedAspectRatio" ElementName="DeviceDisplay"/>
                        <!-- App-wide default (2216/1080) until a stream is known. -->
                        <Binding Path="AspectRatio" Source="{x:Static vm:AppSettings.Instance}"/>
                    </MultiBinding>
                </Border.Height>
                <Grid x:Name="VideoHost">
                    <!-- Client-side rotation via LayoutTransform: ScrcpyDisplay derives
                         everything from DesiredLandscape (user setting) XOR
                         StreamIsLandscape (actual stream orientation) and rotates itself
                         -90° through a LayoutTransform (UpdateRotation), so the rotated
                         element fills the video area through the normal layout path.
                         Rotating only on an orientation mismatch; a RenderTransform
                         variant updated the visual tree but not the screen composition
                         (video stayed clipped to a middle strip). -->
                    <scrcpyWpf:ScrcpyDisplay x:Name="DeviceDisplay" Scrcpy="{Binding Scrcpy}"
                                             DesiredLandscape="{Binding Orientation, Source={x:Static vm:AppSettings.Instance}, Converter={StaticResource OrientationToLandscapeConverter}}"/>

                    <!-- Placeholder shown while disconnected and idle -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllFalseToVisibilityConverter}">
                                <Binding Path="IsConnected"/>
                                <Binding Path="IsConnecting"/>
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="38" Foreground="#4B5563" HorizontalAlignment="Center"/>
                        <TextBlock Text="未连接" FontSize="13" Margin="0,10,0,0"
                                   Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击工具栏第一个按钮开始投屏" FontSize="11" Margin="0,4,0,0"
                                   Foreground="#4B5563" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Spinner shown while connecting -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsConnecting, Converter={StaticResource VisibilityConverter}}">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="34" Foreground="#9CA3AF" HorizontalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <RotateTransform CenterX="17" CenterY="17"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360" Duration="0:0:0.9"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <TextBlock Text="连接中…" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#6B7280" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border.OpacityMask>
                    <VisualBrush Stretch="None">
                        <VisualBrush.Visual>
                            <Border Background="White" CornerRadius="10"
                                    Width="{Binding ActualWidth, ElementName=VideoMask}"
                                    Height="{Binding ActualHeight, ElementName=VideoMask}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
            </Border>

            <!-- ============  Toolbar: flat icon buttons  ============
                 Icons are glyphs from Segoe MDL2 Assets (see App.xaml). -->
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Connect (primary) -->
                <Button Content="&#xE768;" ToolTip="连接" Command="{Binding ConnectCommand}"
                        Style="{StaticResource Button.IconPrimary}"/>
                <!-- Disconnect (hover turns red, disabled unless connected) -->
                <Button Content="&#xE711;" ToolTip="断开" Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Key buttons only work while connected (IsEnabled is inherited) -->
                <WrapPanel IsEnabled="{Binding IsConnected}">

                    <!-- Separator -->
                    <Rectangle Width="1" Height="20" Margin="8,0"
                               Fill="{StaticResource Brush.CardBorder}"/>

                    <!-- Navigation keys -->
                    <!-- ChromeBack -->
                    <Button Content="&#xE72B;" ToolTip="返回" Command="{Binding SendKeycodeCommand}"
                            CommandParameter="{x:Static scrcpy:AndroidKeycode.AKEYCODE_BACK}"/>
                    <!-- Home -->
                    <Button Content="&#xE80F;" ToolTip="主屏" Command="{Binding SendKeycodeCommand}"
                            CommandParameter="{x:Static scrcpy:AndroidKeycode.AKEYCODE_HOME}"/>
                    <!-- TaskView -->
                    <Button Content="&#xE7C4;" ToolTip="最近任务" Command="{Binding SendKeycodeCommand}"
                            CommandParameter="{x:Static scrcpy:AndroidKeycode.AKEYCODE_APP_SWITCH}"/>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="20" Margin="8,0"
                               Fill="{StaticResource Brush.CardBorder}"/>

                    <!-- Volume -->
                    <!-- Add -->
                    <Button Content="&#xE710;" ToolTip="音量+" Command="{Binding SendKeycodeCommand}"
                            CommandParameter="{x:Static scrcpy:AndroidKeycode.AKEYCODE_VOLUME_UP}"/>
                    <!-- Remove -->
                    <Button Content="&#xE738;" ToolTip="音量-" Command="{Binding SendKeycodeCommand}"
                            CommandParameter="{x:Static scrcpy:AndroidKeycode.AKEYCODE_VOLUME_DOWN}"/>
                </WrapPanel>
            </WrapPanel>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
